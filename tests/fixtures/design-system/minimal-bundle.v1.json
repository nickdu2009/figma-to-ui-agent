{
  "bundleVersion": 1,
  "catalogVersion": "1.0.0",
  "specCompatibility": "0.19.0",
  "spec": {
    "routes": {
      "/": {
        "page": {
          "root": "root",
          "elements": {
            "root": {
              "type": "Stack",
              "props": { "direction": "vertical", "gap": "md", "className": null },
              "children": ["title"]
            },
            "title": {
              "type": "Heading",
              "props": { "text": "示例应用", "level": "h1", "className": null },
              "children": []
            }
          }
        }
      }
    },
    "state": {
      "ui": {
        "detail": { "open": false }
      }
    }
  },
  "designSystem": {
    "tokens": {
      "primitive": {
        "color.primary": { "type": "color", "value": "#1a73e8" },
        "space.md": { "type": "length", "value": 16, "unit": "px" }
      },
      "semantic": {
        "color.surface": { "$token": "color.primary" }
      },
      "component": {
        "Button": {
          "background": { "$token": "color.primary" },
          "radius": { "type": "length", "value": 6, "unit": "px" }
        }
      }
    },
    "applicationCss": ""
  },
  "assets": {
    "entries": []
  }
}
