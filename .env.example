# vite-multipage-agent 本地开发环境样例。
# 所有凭据均为本地开发专用；不得把真实凭据写入本文件或提交。

# --- 数据库（对应 docker-compose.yml，GATE-00 决策补充 §5） ---
# 应用连接串；默认值指向 docker compose 提供的本地 MySQL。
# VMA_DATABASE_URL=mysql://vma:vma-local-dev-only@127.0.0.1:3317/vite_multipage_agent

# --- Agent 模式与 LLM（沿用现状） ---
# VMA_AGENT_MODE=openai | mock | probe
# OPENAI_API_KEY=（真实 Key 只放本机未提交的环境，不入库）

# --- 服务端口 ---
# VMA_SERVER_PORT=3101

# --- 账号 ---
# 管理员邮箱（逗号分隔；首次完成邮箱验证即取得管理员角色，设计 §4.1）：
# ADMIN_EMAILS=admin@example.com

# --- 测试 ---
# vitest 的 per-test schema 隔离使用的管理员连接串（仅指向本地开发库）：
# VMA_TEST_ADMIN_DATABASE_URL=mysql://root:vma-root-local-dev-only@127.0.0.1:3317
