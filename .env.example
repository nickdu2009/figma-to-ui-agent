# 真实凭据只在本机环境中配置，不要提交 .env 或 .envrc。
OPENAI_API_KEY=
# 可选；OpenAI-compatible 网关应填写到兼容 API 基础路径。
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4
# PI_OPENAI_MODEL 优先于 OPENAI_MODEL。
PI_OPENAI_MODEL=gpt-5.4
OPENAI_LIVE_PROBE_AUTHORIZED=0

# Figma 正式通道是官方 REST API。文件键和节点只用于获授权的探针。
FIGMA_API_KEY=
FIGMA_FLOW_FILE_KEY=
FIGMA_FLOW_NODE_ID=
FIGMA_REST_LIVE_PROBE_AUTHORIZED=0

# 总体 M0 live 入口仍需单独授权；本地模式不读取凭据或访问网络。
M0_LIVE_PROBE_AUTHORIZED=0

# M3 Flow 校准。视口和比较参数必须是 JSON；当前冻结策略允许至少一个明确 viewport。
M3_FLOW_EXTERNAL_AUTHORIZED=0
M3_FLOW_INPUT_CONFIRMED=0
M3_FLOW_PROJECT_ID=
M3_FLOW_FIGMA_URL=
M3_FLOW_VIEWPORTS_JSON=
M3_FLOW_COMPARISON_JSON=
M3_FLOW_BEHAVIOR_NOTES=

# Flow 通过且人工审阅候选参数后，冻结命令还需要以下两个确认。
M3_FLOW_CALIBRATION_CONFIRMED=0
M3_VISUAL_THRESHOLD_CONFIRMED=0

# 每个未知输入使用独立 case。清单步骤不访问网络，只保存输入哈希。
M3_CASE_ID=
M3_FIGMA_URL=
M3_TARGET_NODES=
M3_BEHAVIOR_NOTES=
M3_UNKNOWN_INPUT_CONFIRMED=0
M3_EXTERNAL_AUTHORIZED=0
# 三个 case 全部结束后用于最终本地汇总，例如 case-a,case-b,case-c。
M3_CASE_IDS=

# Playwright 浏览器保存在项目忽略目录。
PLAYWRIGHT_BROWSERS_PATH=./data/playwright-browsers
