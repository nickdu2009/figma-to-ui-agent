{
  "name": "next-app-runtime-website-builder",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run build --workspace @next-app-runtime/client && vite",
    "build": "npm run build --workspace @next-app-runtime/client && vite build",
    "start": "vite preview",
    "typecheck": "npm run build --workspace @next-app-runtime/client && tsc --noEmit",
    "test": "npm run build --workspace @next-app-runtime/client && vitest run",
    "test:browser": "npm run build && playwright test --config playwright.config.ts",
    "test:parity": "playwright test --config playwright.parity.config.ts"
  },
  "dependencies": {
    "@json-render/core": "0.19.0",
    "@json-render/react": "0.19.0",
    "@json-render/shadcn": "0.19.0",
    "@next-app-runtime/client": "0.1.0",
    "@visual-json/react": "0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-resizable-panels": "^4.7.6",
    "tailwind-merge": "^3.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
